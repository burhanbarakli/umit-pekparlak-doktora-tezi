# Ham kaynak deposu: yalnız dizin/README notları izlenir.
# Arşivler, Word/PDF kaynakları ve gelen paketler diskte kalır.
/dosyalar/**
!/dosyalar/**/
!/dosyalar/**/*.md
# Tezin göreli yolla okuduğu Senaryo 1-3 ekranları (tez-latex-v2 derlemesi için gerekli)
!/dosyalar/05_sonradan_gelenler/Senaryo_*/*.jpg
/jüri istekleri/*.pdf

# Geçici çalışma alanları
/tmp/
/build/
/tez-matlab-simulink/tmp/
/tez-matlab-simulink/build/
/tez-matlab-simulink/runs/**/slprj/
/tez-latex/tmp/

# LaTeX derleme çıktıları (kalıcı sürümler zaten tarihli PDF'lerde)
/tez-latex/build*/
/tez-latex-v2/build*/
/tez-latex/main.pdf
/tez-latex-v2/main.pdf
/tez-latex/tez_guncel_*.pdf
/tez-latex-v2/tez_guncel_*.pdf
/tez-latex/historical_main.*
/tez-latex/main.aux
/tez-latex/main.bbl
/tez-latex/main.blg
/tez-latex/main.lof
/tez-latex/main.log
/tez-latex/main.lot
/tez-latex/main.out
/tez-latex/main.toc
*.synctex.gz

# MATLAB/Simulink üretilmiş dosyaları
slprj/
*.slxc
*.mexa64
*.mexw64
*.asv
*.autosave
*.slx.r20*

# Sonuç yedekleri
/tez-matlab-simulink/results_yedek_*/

# Araç klasörleri
/.agents/
/.codex/
/tez-latex/tmp_render/

# Benzetim koşu çıktıları: ham dalga kayıtları (0,8-1,8 GB; betikle yeniden üretilir).
# runs/*/model*/ içindeki .slx ve .m kopyaları izlenir: kalibre, onarılmış ve
# kapalı çevrim modeller yalnız orada bulunur. Derleme artıkları dışarıda kalır.
/tez-matlab-simulink/runs/**/logsout.mat
/tez-matlab-simulink/runs/**/*.mat
/tez-matlab-simulink/runs/**/model*/**/*.slx.original
/tez-matlab-simulink/runs/**/model*/**/*.bak
*_acc.exp
*_acc.lib

# yeni_tez (SAU FBE sablonu, LuaLaTeX) derleme ciktilari
/yeni_tez/*.aux
/yeni_tez/*.bbl
/yeni_tez/*.blg
/yeni_tez/*.log
/yeni_tez/*.out
/yeni_tez/*.toc
/yeni_tez/*.lof
/yeni_tez/*.lot
/yeni_tez/*.fls
/yeni_tez/*.fdb_latexmk
/yeni_tez/bolumler/*.aux
/yeni_tez/onkisim/*.aux
/yeni_tez/tez.pdf
/yeni_tez/tez_notlu.pdf
/yeni_tez/tez_guncel_*.pdf

# Ayakaleaf (yerel Overleaf) eslitleme ayari; makineye ozel
/.ayakaleaf.local
/yeni_tez/fonts/
/yeni_tez/depo/

# Dışarıya paylaşılan paketler (Drive); depoda zaten olan modellerin kopyaları ve büyük .mat dosyaları
/paylasim/
