%% tezpaketleri.sty
%% sauthesis.cls (SAU FBE LaTeX sablonu) uzerine bu tezin ihtiyac duydugu paketler,
%% makrolar ve sablonun notsuz ciktidaki kucuk aksakliklarinin duzeltmeleri.
%% sauthesis.cls ve sauwordline.lua sablondan oldugu gibi alinmistir; degistirilmez.
%% Sablonun yeni surumu gelirse yalniz o iki dosya degistirilir, bu dosya kalir.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tezpaketleri}[2026/11/15 Umit Pekparlak doktora tezi ekleri]

%------------------------------------------------------------------ paketler
\RequirePackage[table]{xcolor}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{siunitx}
\sisetup{output-decimal-marker={,},mode=text}
\DeclareSIUnit\voltampere{VA}% "kV A" yerine "kVA"% sayılar ve birimler metin yazı tipiyle (Times); matematik yazı tipiyle karışmasın
\RequirePackage{subcaption}
% Birden çok satıra taşan alt şekil yazıları dar sütunda iki yana yaslanınca sözcük araları
% açılıyordu; alt şekil yazıları ortalanır (tek satırlıklar zaten ortalıydı).
\captionsetup[subfigure]{format=plain,justification=centering}
\RequirePackage{tikz}
\RequirePackage{circuitikz}
\usetikzlibrary{arrows.meta,positioning,fit,calc,decorations.pathmorphing}
% Tek dosyadan gelen çok panelli şekillerin üstüne panel harfi yazar.
% #1: görsel (\includegraphics...), #2: konum/harf listesi; konum, panel ortasının görsel
% genişliğine oranıdır (ör. {0.26/a, 0.78/b}).
\newcommand{\panelharfli}[2]{%
  \begin{tikzpicture}
    \node[anchor=south west,inner sep=0pt] (pnlg) at (0,0) {#1};
    \foreach \px/\pl in {#2}
      \path (pnlg.north west) -- (pnlg.north east)
        node[pos=\px,above=1mm,inner sep=0pt,font=\footnotesize] {(\pl)};
  \end{tikzpicture}}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}
\RequirePackage[sort&compress,numbers]{natbib}

% Sekiller cogaltilmaz: tez-latex-v2/figures ve tez-latex/figures depolari okunur.
% MATLAB sonuclari bolum metninde ../tez-matlab-simulink/... goreli yoluyla gelir.
\graphicspath{{../tez-latex-v2/figures/}{../tez-latex/figures/}%
  % Ayakaleaf (yerel Overleaf) projesinde ust klasor yoktur; komsu klasorler depo/
  % altinda aynalanir (bkz. ayakaleaf_esitle.sh). depo/yeni_tez/ girdisi, metindeki
  % ../tez-matlab-simulink/... yollarini depo/tez-matlab-simulink/... olarak cozer.
  % Bu klasorler depoda yoktur; yerel derlemede bu girdiler etkisizdir.
  {depo/tez-latex-v2/figures/}{depo/tez-latex/figures/}{depo/yeni_tez/}}

% Ayakaleaf derleme kabinda Times New Roman / Cambria Math yuklu degildir; sinif bu
% durumda TeX Gyre Termes'e duser. Proje icinde fonts/ klasoru varsa (yalniz Ayakaleaf
% projesinde bulunur, git'e girmez) ayni yazi tipleri oradan yuklenir. Windows'ta
% fonts/ olmadigi icin sinifin sistem yazi tipi secimi aynen kalir.
\IfFileExists{fonts/times.ttf}{%
  \setmainfont{times.ttf}[Path=fonts/,BoldFont=timesbd.ttf,ItalicFont=timesi.ttf,
    BoldItalicFont=timesbi.ttf,Ligatures=NoCommon,Kerning=Off]%
}{}
\IfFileExists{fonts/Cambria.ttc}{\setmathfont{Cambria.ttc}[Path=fonts/,FontIndex=1]}{}

%------------------------------------------------------------------ satir araligi uyumu
% tez-latex-v2 metni setspace komutlarini kullanir; sablonun Word satir modeline baglanir.
\providecommand\singlespacing{\teksatir}
\providecommand\onehalfspacing{\birbucuksatir}
% Sablon \small ve \footnotesize'i Word modeline gore tanimlar; \scriptsize da ayni bicimde.
\makeatletter
\renewcommand\scriptsize{\fontsize{8bp}{5.73bp}\selectfont\sau@asc{7.48bp}\sau@setline{9.2bp}}
\makeatother

%------------------------------------------------------------------ ÜMİT ABİ İÇİN NOT kutusu
% Tez sahibine bilgi notu; tez metninin parcasi degildir (K-28).
% tez.tex notsuz derlenir; tez_notlu.tex \UMITNOTLARI tanimlayip tez.tex'i okur.
\newif\ifumitnotlari
\ifdefined\UMITNOTLARI\umitnotlaritrue\else\umitnotlarifalse\fi
\ifumitnotlari
  \RequirePackage[breakable,skins]{tcolorbox}
  \newtcolorbox{umitnotkutusu}[1]{breakable, enhanced jigsaw, colback=blue!6, colframe=blue!60!black,
    boxrule=0.6pt, arc=1pt, left=4pt, right=4pt, top=3pt, bottom=3pt, fontupper=\small,
    title={\textbf{ÜMİT ABİ İÇİN NOT --- TESLİMDE ÇIKARILACAK}\quad #1}, fonttitle=\small}
\fi
\newcommand{\umitnot}[2]{%
  \ifumitnotlari
  \par\medskip
  \begin{umitnotkutusu}{#1}
    #2
  \end{umitnotkutusu}
  \par\medskip
  \fi
}

% ŞEKİL SONRASI BÖLÜM BAŞLIĞI: [H] şeklin hemen ardından gelen \section için üst boşluk.
% Şeklin \intextsep (12bp) boşluğu ile başlığın 12bp üst boşluğu \addvspace ile birleşip 12bp
% kaldığından, kılavuzdaki şekil sonrası başlık boşluğu için 18bp verilir (990172d).
% Kullanım: \end{figure} satırından sonra, \section satırından önce \sekilsonrabaslik.
\newcommand{\sekilsonrabaslik}{\addvspace{18bp}}

% KIRMIZI KONTROL NOTU: tez sahibinin bilgisi ya da kararı gereken, kaçırılmaması gereken yer
% (proje sahibi, 18.11.2026; K-41). Ana derlemede görünür. Teslimden önce hepsi çözülmeli ve
% \kirmizinotlarfalse ile kapatılmalıdır (çözülmemiş not kalırsa kapatmak onu gizler, çözmez).
\newif\ifkirmizinotlar \kirmizinotlartrue
\newcommand{\kirmizinot}[1]{%
  \ifkirmizinotlar
  \par\smallskip
  \noindent\fcolorbox{red!75!black}{red!5}{%
    \begin{minipage}{0.96\linewidth}
      \small\color{red!75!black}\textbf{KONTROL ---} #1
    \end{minipage}%
  }%
  \par\smallskip
  \fi
}

% EKSİK ÇALIŞMA bari (tez-latex-v2 kurali; su an metinde kullanilmiyor).
\newcommand{\eksikistek}[2]{%
  \par\medskip
  \noindent\fcolorbox{orange!85!black}{orange!12}{%
    \begin{minipage}{0.94\linewidth}
      \small
      \colorbox{orange!85!black}{\strut\textcolor{white}{\textbf{EKSİK ÇALIŞMA --- BUNU İSTİYORUZ}}}\ \textbf{#1}\par\smallskip
      #2
    \end{minipage}%
  }%
  \par\medskip
}

