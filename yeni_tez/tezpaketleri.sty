% Onay sayfasi: jüri yuvalari tez.tex'teki \juri... komutlarindan doldurulur.
% Kilavuz yuvalari: 12 (baskan) / 14 (danisman) / 16 (ortak danisman) / 18 / 20 / 22 cm.
% Ortak danisman yoksa 16 cm yuvasi bos kalir. Verilmeyen ad ve kurum gri yer tutucuyla basilir.
\newcommand\sau@jyt[1]{\sau@gri{#1}}
\def\sau@jbad{\sau@jyt{Unvan Adı SOYADI}}\def\sau@jbkurum{\sau@jyt{Üniversite}}
\def\sau@jdad{\sau@danisman}\def\sau@jdkurum{Sakarya Üniversitesi}
\def\sau@juad{\sau@jyt{Unvan Adı SOYADI}}\def\sau@jukurum{\sau@jyt{Üniversite}}
\def\sau@jvad{\sau@jyt{Unvan Adı SOYADI}}\def\sau@jvkurum{\sau@jyt{Üniversite}}
\def\sau@jzad{\sau@jyt{Unvan Adı SOYADI}}\def\sau@jzkurum{\sau@jyt{Üniversite}}
% Kurum (ikinci argüman) boş verilirse gri "Üniversite" yer tutucusu kalır.
\newcommand\sau@jkur[2]{\if\relax\detokenize{#2}\relax\else\def#1{#2}\fi}
\newcommand\juribaskani[2]{\def\sau@jbad{#1}\sau@jkur\sau@jbkurum{#2}}
\newcommand\juridanisman[2]{\def\sau@jdad{#1}\sau@jkur\sau@jdkurum{#2}}
\newcommand\juriuyesiA[2]{\def\sau@juad{#1}\sau@jkur\sau@jukurum{#2}}
\newcommand\juriuyesiB[2]{\def\sau@jvad{#1}\sau@jkur\sau@jvkurum{#2}}
\newcommand\juriuyesiC[2]{\def\sau@jzad{#1}\sau@jkur\sau@jzkurum{#2}}
